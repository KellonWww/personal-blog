---
import '@fontsource-variable/outfit';
import '@/styles/globals.css';
import '@/styles/admin.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 博客后台</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=leaf-1" />
    <meta name="theme-color" content="#142126" />
    <script is:inline>
      (function () {
        var legacy = { light: 'dianqing', dark: 'moye', xuanzhi: 'moye', songyan: 'moye', taichen: 'dianqing', xingye: 'dianqing' };
        var id = null;
        try {
          var stored = localStorage.getItem('blog-theme');
          id = legacy[stored] || (stored === 'moye' || stored === 'dianqing' ? stored : null);
          if (id && stored !== id) localStorage.setItem('blog-theme', id);
        } catch (e) { /* 存储不可用时跟随系统 */ }
        if (!id) id = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'moye' : 'dianqing';
        var root = document.documentElement;
        root.setAttribute('data-theme', id);
        root.classList.toggle('dark', id === 'moye');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', id === 'moye' ? '#142126' : '#f0ecdf');
      })();
    </script>
  </head>
  <body class="min-h-screen bg-surface text-ink">
    <slot />
  </body>
</html>
