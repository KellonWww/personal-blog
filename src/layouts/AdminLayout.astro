---
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Vary', 'Cookie');
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);

import '@fontsource-variable/outfit';
import '@/styles/globals.css';
import '@/styles/admin.css';
import '@/styles/studio.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t(title)} · {t("博客后台")}</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=leaf-1" />
    <meta name="theme-color" content="#141b2d" />
    <script is:inline>
      (function () {
        var legacy = { light: 'dianqing', dark: 'moye', xuanzhi: 'moye', songyan: 'moye', taichen: 'dianqing', xingye: 'dianqing' };
        var id = null;
        try {
          var stored = localStorage.getItem('blog-theme');
          id = legacy[stored] || (stored === 'moye' || stored === 'dianqing' ? stored : null);
          if (id && stored !== id) localStorage.setItem('blog-theme', id);
        } catch (e) { /* 存储不可用时跟随系统 */ }
        if (!id) id = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'moye' : 'dianqing';
        var root = document.documentElement;
        root.setAttribute('data-theme', id);
        root.classList.toggle('dark', id === 'moye');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', id === 'moye' ? '#141b2d' : '#f4f0e7');
      })();
    </script>
  </head>
  <body class="admin-site min-h-screen bg-surface text-ink">
    <slot />
  </body>
</html>
