---
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Vary', 'Cookie');
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);

import { env } from 'cloudflare:workers';
import '@fontsource-variable/outfit';
import '@/styles/globals.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchDialog from '@/components/SearchDialog.astro';
import '@/styles/interactions.css';
import '@/styles/studio.css';
import { getSiteProfile } from '@/server/db/settings';

interface Props {
  title: string;
  description?: string;
  active?: string;
  type?: 'website' | 'article';
  showReadingTools?: boolean;
  canonical?: string;
}

const { title, description, active = '', type = 'website', showReadingTools = false, canonical } = Astro.props;

let profile = null;
try {
  profile = await getSiteProfile(env.DB);
} catch {
  profile = null;
}

const siteName = profile?.name ?? 'Kale的数字花园';
const siteDescription = description ?? profile?.bio ?? '记录技术、阅读和生活的个人博客。';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const socialLinks = profile?.socialLinks ?? [];
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=leaf-1" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#141b2d" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <script is:inline>
      (function () {
        var legacy = { light: 'dianqing', dark: 'moye', xuanzhi: 'moye', songyan: 'moye', taichen: 'dianqing', xingye: 'dianqing' };
        var id = null;
        try {
          var stored = localStorage.getItem('blog-theme');
          id = legacy[stored] || (stored === 'moye' || stored === 'dianqing' ? stored : null);
          if (id && stored !== id) localStorage.setItem('blog-theme', id);
        } catch (e) { /* 存储不可用时跟随系统 */ }
        if (!id) id = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'moye' : 'dianqing';
        var root = document.documentElement;
        root.setAttribute('data-theme', id);
        root.classList.toggle('dark', id === 'moye');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', id === 'moye' ? '#141b2d' : '#f4f0e7');
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="public-site min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-ink">{t("跳到正文")}</a>
    <Header siteName={siteName} active={active} showReadingTools={showReadingTools} />
    <main id="main" class="site-shell site-main py-6 md:py-8">
      <slot />
    </main>
    <Footer siteName={siteName} icp={profile?.icp} startedAt={profile?.startedAt} socialLinks={socialLinks} />
    <script>
      import { mountPageMotion } from '@/lib/page-motion';
      const main = document.querySelector<HTMLElement>('#main');
      if (main) {
        let cleanup = mountPageMotion(main);
        window.addEventListener('pagehide', () => cleanup());
        window.addEventListener('pageshow', (event) => {
          if (event.persisted) cleanup = mountPageMotion(main);
        });
      }
    </script>
    <SearchDialog />
    <slot name="scripts" />
  </body>
</html>
