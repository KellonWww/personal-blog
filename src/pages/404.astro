---
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title={t("页面不存在")} description="404">
  <div class="py-24">
    <p class="font-mono text-5xl font-semibold text-accent tabular-nums">404</p>
    <p class="mt-4 text-sm text-muted">{t("这个页面走丢了。")}</p>
    <div class="mt-6 flex gap-2">
      <a href="/" class="btn btn-primary">{t("返回首页")}</a>
      <a href="/post" class="btn">{t("浏览文章")}</a>
    </div>
  </div>
</BaseLayout>

