---
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);

import { env } from 'cloudflare:workers';
import AdminLayout from '@/layouts/AdminLayout.astro';
import LoginForm from '@/components/LoginForm';
import { loginDestination } from '@/lib/auth-redirect';

const oauthEnabled = Boolean(env.GITHUB_CLIENT_ID && env.GITHUB_CLIENT_SECRET);
const devMode = env.ENVIRONMENT === 'development' && env.AUTH_DEV_MODE === 'true';
const errorCode = Astro.url.searchParams.get('error') ?? '';
const returnTo = loginDestination(Astro.url.searchParams.get('returnTo'));
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<AdminLayout title={t("登录")}>
  <main class="admin-login">
    <section class="admin-login-story" aria-label={t("数字花园管理空间")}>
      <a href="/" class="admin-brand"><span class="admin-brand-mark">K</span><span>Kale<span class="admin-brand-caption">{t("数字花园")}</span></span></a>
      <div><p class="admin-login-caption">{t("回到自己的写作角落")}</p><h2>{t("让零散的想法，")}<br />{t("有地方生长。")}</h2><p>{t("写下所学，留下所想。")}</p></div>
      <span class="admin-login-signature">{t("好好写作，慢慢生长。")}</span>
    </section>
    <section class="admin-login-form" aria-labelledby="login-title">
      <h1 id="login-title">{returnTo === '/admin' ? t('博客后台登录') : t('登录后阅读私人文库')}</h1>
      <p class="admin-login-intro">{returnTo === '/admin' ? t('欢迎回来，花园正在等你。') : t('这里的内容仅向管理员开放。')}</p>
      <LoginForm locale={locale} client:load oauthEnabled={oauthEnabled} devMode={devMode} errorCode={errorCode} returnTo={returnTo} />
      <a href="/" class="admin-login-back">{t("返回数字花园")}</a>
    </section>
  </main>
</AdminLayout>

