---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LoginForm from '@/components/LoginForm';
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
import { loginDestination } from '@/lib/auth-redirect';

const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);
const oauthEnabled = Boolean(env.GITHUB_CLIENT_ID && env.GITHUB_CLIENT_SECRET);
const devMode = env.ENVIRONMENT === 'development' && env.AUTH_DEV_MODE === 'true';
const errorCode = Astro.url.searchParams.get('error') ?? '';
const returnTo = loginDestination(Astro.url.searchParams.get('returnTo'));
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<BaseLayout title={t('登录')}>
  <section class='public-login' aria-labelledby='login-title'>
    <div class='public-login-heading'>
      <p>{t('数字花园')}</p>
      <h1 id='login-title'>{t('欢迎回来')}</h1>
      <p>{t('登录后参与评论与留言，留下你的想法。')}</p>
    </div>
    <LoginForm locale={locale} client:load oauthEnabled={oauthEnabled} devMode={devMode} errorCode={errorCode} returnTo={returnTo} />
    <a href='/' class='public-login-back'>{t('返回数字花园')} ↗</a>
  </section>
</BaseLayout>

<style>
  .public-login { width: min(100% - 3rem, 28rem); margin: clamp(3rem, 10vh, 7rem) auto; padding-block: 2rem; }
  .public-login-heading { margin-bottom: 2rem; }
  .public-login-heading > p:first-child { color: var(--accent); font-size: .75rem; margin-bottom: 1rem; }
  .public-login h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 600; letter-spacing: -.04em; }
  .public-login-heading > p:last-child { color: var(--muted); font-size: .875rem; line-height: 1.8; margin-top: 1rem; }
  .public-login-back { display: inline-block; margin-top: 2rem; color: var(--muted); font-size: .8rem; border-bottom: 1px solid var(--line); padding-bottom: .25rem; }
</style>
