---
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);

import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import MermaidEnhancer from '@/components/MermaidEnhancer.astro';
import { getArchive } from '@/server/services/archives';
import { archiveIdSchema } from '@/server/services/archive-query';
import { renderPrivateMarkdown } from '@/lib/private-markdown';
import { countWords, formatDate, readingTime } from '@/lib/format';

export const prerender = false;
if (!Astro.locals.privateLibraryAuthorized) return Astro.redirect('/admin/login');

const id = archiveIdSchema.safeParse(Astro.params.id);
const archive = id.success ? await getArchive(env.DB, id.data) : null;
if (!archive) Astro.response.status = 404;
const version = archive?.currentVersion;
const rendered = version ? renderPrivateMarkdown(version.content) : '';
---

<BaseLayout title={t("私人文库")} description={t("只属于你的阅读空间。")} active="private-library" showReadingTools={Boolean(archive)}>
  <meta slot="head" name="robots" content="noindex, nofollow, noarchive" />
  <div class="mx-auto mb-7 flex max-w-3xl flex-wrap items-center justify-between gap-3 text-sm no-print">
    <a href="/private" class="text-muted hover:text-accent">{t("← 返回私人文库")}</a>
    <span class="chip">{t("仅自己可见")}</span>
  </div>
  {archive && version ? <article class="mx-auto max-w-3xl">
    <header class="border-b border-line pb-7">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.72rem] tabular-nums text-muted">
        <span>{t("更新于")}<time datetime={archive.updatedAt}>{formatDate(archive.updatedAt, locale)}</time></span>
        <span class="text-line-strong">/</span>
        <span>{t("{0} 阅读时长", readingTime(countWords(version.content), locale))}</span>
        <span class="text-line-strong">/</span>
        <span>{archive.sourceName}</span>
      </div>
      <h1 class="mt-4 break-words text-[1.7rem] font-semibold leading-[1.3] tracking-tight md:text-[2.1rem]" data-convertible>{version.title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-muted">
        {version.metadata.categories.map((name) => <span>{name}</span>)}
        {version.metadata.tags.map((name) => <span>#{name}</span>)}
      </div>
      {archive.conflictState === 'pending' && <p class="mt-4 text-sm text-muted">{t("来源有更新待核对。此处阅读的是你已保存的版本，可前往后台处理。")}</p>}
    </header>
    <div class="prose-editorial mt-8" data-convertible set:html={rendered} />
    <footer class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-5 text-sm text-muted no-print">
      <p>{t("私人阅读 · 不公开分享")}</p>
      <div class="flex gap-2"><a class="btn" href="/private">{t("返回文库")}</a><a class="btn" href="/admin?view=archives">{t("管理档案")}</a></div>
    </footer>
    <p class="mt-4 text-xs leading-relaxed text-muted no-print">{t("为保护隐私，文档中的图片不会自动加载，外部链接仅在点击后打开。")}</p>
  </article> : <section class="mx-auto max-w-3xl border-y border-line py-12">
    <h1 class="text-2xl font-semibold">{t("文档不存在")}</h1>
    <p class="mt-3 text-sm text-muted">{t("这份文档可能已删除，或其来源已停用。返回文库查看其他文档。")}</p>
    <a class="btn mt-6" href="/private">{t("返回私人文库")}</a>
  </section>}
  {archive && <MermaidEnhancer />}
</BaseLayout>
