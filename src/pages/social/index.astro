---
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);

import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeading from '@/components/PageHeading.astro';
import { getSiteSettings } from '@/server/db/settings';
import { publicFriends } from '@/lib/friends';

const db = env.DB;
const settings = await getSiteSettings(db);
const friends = publicFriends(settings['site.friends'] ?? '[]');
---

<BaseLayout title={t("友人帐")} description={t("友情链接")}>
  <PageHeading title={t("友人帐")} description={t("沿着链接，去朋友的花园坐坐。")} />
  {friends.length === 0 ? (
    <div class="mt-6 border-l-2 border-line pl-4 text-sm text-muted">
      <p>{t("还没有配置友链。")}</p>
    </div>
  ) : (
    <div class="mt-6 border-t border-line">
      {friends.map((friend) => (
        <a href={friend.url} class="group flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-line py-5 transition-colors hover:text-accent" target="_blank" rel="noopener noreferrer">
          <h2 class="text-base font-semibold tracking-tight">{friend.name}</h2>
          <p class="text-sm text-muted">{friend.desc || friend.url}</p>
          <span class="ml-auto font-mono text-xs text-muted">↗</span>
        </a>
      ))}
    </div>
  )}
</BaseLayout>

