---
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);

import ToolLayout from '@/layouts/ToolLayout.astro';
import TimeConverter from '@/components/toolbox/TimeConverter';
---
<ToolLayout title={t("时间转换")} description={t("在时间戳和日期之间来回换算，也把不同时区的时间对齐。")} active="/toolbox/time">
  <TimeConverter locale={locale} client:load />
</ToolLayout>
