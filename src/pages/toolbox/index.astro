---
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);

import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeading from '@/components/PageHeading.astro';
import ToolIcon from '@/components/toolbox/ToolIcon.astro';
import { tools } from '@/lib/tool-definitions';


---

<BaseLayout title={t("工具箱")} description={t("常用工具入口")} active="toolbox">
  <PageHeading title={t("手边的工具")} description={t("写作、查找、整理。把日常用得上的入口，放在顺手的地方。")} />
  <div class="tool-shelf">
    {tools.map((tool) => (
      <section class="tool-entry" data-ready={tool.ready} data-motion>
        <div class="tool-entry-heading"><h2><ToolIcon name={tool.icon} size="1.15em" />{t(tool.name)}</h2><span>{tool.ready ? t('可用') : t('规划中')}</span></div>
        <p>{t(tool.desc)}</p>
        {tool.ready && tool.href ? <a href={tool.href} class="tool-open">{t("打开")} {t(tool.name)}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.5" /></svg></a> : <span class="tool-planned">{t("尚未实现，暂不开放")}</span>}
      </section>
    ))}
  </div>
</BaseLayout>

<!-- avoid-ai-design-ignore-file: K7 — 键盘焦点样式为全局 :focus-visible（globals.css） -->

<style>
  .tool-entry-heading h2 { display: flex; align-items: center; gap: .65rem; }
</style>
