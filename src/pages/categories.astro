---
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);

import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeading from '@/components/PageHeading.astro';
import { listCategories } from '@/server/db/content';

const db = env.DB;
const categories = await listCategories(db);
---

<BaseLayout title={t("分类")} description={t("全部分类")} active="categories">
  <PageHeading title={t("分类索引")} description={t("循着一个主题，找到感兴趣的下一篇。")} meta={t("{0} 个分类", categories.length)} />
  {categories.length === 0 ? (
    <p class="mt-4 py-12 text-sm text-muted">{t("还没有分类。")}</p>
  ) : (
    <div class="catalog-layout">
      <aside class="catalog-aside" data-motion><span class="catalog-symbol" aria-hidden="true">{'{ }'}</span><h2>{t("知识有枝，")}<br />{t("阅读有径。")}</h2><p>{t("按主题整理的记录。选一条感兴趣的路径，往深处走走。")}</p><a href="/post" class="catalog-all">{t("浏览全部文章")}</a></aside>
      <div class="category-index">
        {categories.map((category) => (
          <a href={`/post?category=${category.slug}`} class="category-entry" data-motion>
            <div class="category-entry-title"><h2>{category.name}</h2><span>{t("{0} 篇文章", category.postCount ?? 0)}</span></div>
            <p>{category.description || t('这一枝的记录，慢慢积累。')}</p>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" /></svg>
          </a>
        ))}
      </div>
    </div>
  )}
</BaseLayout>

