---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeading from '@/components/PageHeading.astro';
import { listCategories } from '@/server/db/content';

const db = env.DB;
const categories = await listCategories(db);
---

<BaseLayout title="分类" description="全部分类" active="categories">
  <PageHeading title="分类索引" description="循着一个主题，找到感兴趣的下一篇。" meta={`${categories.length} 个分类`} />
  {categories.length === 0 ? (
    <p class="mt-4 py-12 text-sm text-muted">还没有分类。</p>
  ) : (
    <div class="catalog-layout">
      <aside class="catalog-aside" data-motion><span class="catalog-symbol" aria-hidden="true">{'{ }'}</span><h2>知识有枝，<br />阅读有径。</h2><p>按主题整理的记录。选一条感兴趣的路径，往深处走走。</p><a href="/post" class="catalog-all">浏览全部文章</a></aside>
      <div class="category-index">
        {categories.map((category) => (
          <a href={`/post?category=${category.slug}`} class="category-entry" data-motion>
            <div class="category-entry-title"><h2>{category.name}</h2><span>{category.postCount ?? 0} 篇</span></div>
            <p>{category.description || '这一枝的记录，慢慢积累。'}</p>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" /></svg>
          </a>
        ))}
      </div>
    </div>
  )}
</BaseLayout>

