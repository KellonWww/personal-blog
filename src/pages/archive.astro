---
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);

import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeading from '@/components/PageHeading.astro';
import { listPublishedSummaries } from '@/server/db/content';
import { groupByYear } from '@/server/services/content';
import { formatDate } from '@/lib/format';

const db = env.DB;
const posts = await listPublishedSummaries(db);
const groups = groupByYear(posts);
---

<BaseLayout title={t("归档")} description={t("按时间浏览全部文章")} active="archive">
  <PageHeading title={t("时光归档")} description={t("沿着时间，看看这座花园如何生长。")} />
  {groups.length === 0 ? (
    <p class="mt-4 py-12 text-sm text-muted">{t("还没有可归档的文章。")}</p>
  ) : (
    <div class="archive-timeline">
      {groups.map((group) => (
        <section class="timeline-year">
          <div class="timeline-year-label" data-motion><h2>{group.year}</h2></div>
          <ul>
            {group.posts.map((post) => (
              <li class="timeline-entry" data-motion>
                <time class="font-mono text-xs text-muted tabular-nums">{formatDate(post.publishedAt ?? post.createdAt, locale)}</time>
                <a href={`/post/${post.slug}`} class="font-medium transition-colors hover:text-accent">{post.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}
</BaseLayout>

