---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getSiteSummary, listPosts, listTags } from '@/server/db/content';
import { getSiteProfile } from '@/server/db/settings';
import GardenMotion from '@/components/GardenMotion.tsx';
import { formatNumber } from '@/lib/format';

const db = env.DB;
const [profile, latest, tags, summary] = await Promise.all([
  getSiteProfile(db),
  listPosts(db, { page: 1, pageSize: 6 }),
  listTags(db),
  getSiteSummary(db)
]);

const lede = [
  { label: '篇文章', value: summary.postCount },
  { label: '字记录', value: summary.totalWords }
];
const hasKaleName = profile.name.startsWith('Kale');
const motto = profile.motto || '写下所学，留下所想。';
---

<BaseLayout title={profile.name} description={profile.bio} active="home">
  <div class="living-garden" data-garden>
    <section class="folio-hero" aria-labelledby="garden-title">
      <div class="folio-copy" data-motion>
        <p class="folio-greeting">你好，我是 Kale。这里存放我的好奇心。</p>
        <h1 id="garden-title">{hasKaleName ? <><span class="folio-name">Kale<span class="folio-period">.</span></span><span class="folio-subtitle">的数字花园<span class="folio-avatar">{profile.avatar && <img src={profile.avatar} alt="Kale 的 GitHub 头像" width={72} height={72} />}</span></span></> : profile.name}</h1>
        <p class="folio-bio">{profile.bio}</p>
        <div class="folio-actions">
          <a href="#latest" class="btn btn-primary" data-magnetic><span>走进花园</span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></a>
          <a href="/about" class="folio-about">认识园主 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure class="growth-art" aria-label="由代码与文字长成的抽象植物">
        <svg class="growth-svg" viewBox="0 0 480 480" fill="none" role="img" aria-labelledby="growth-title">
          <title id="growth-title">一株正在生长的数字植物</title>
          <defs><pattern id="garden-grid" width="32" height="32" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="currentColor" opacity=".17" /></pattern></defs>
          <rect width="480" height="480" fill="url(#garden-grid)" />
          <circle class="growth-orbit" cx="240" cy="240" r="192" stroke="currentColor" stroke-opacity=".18" stroke-dasharray="3 8" />
          <path d="M240 418V182" stroke="currentColor" stroke-width="2" />
          <g class="growth-leaf growth-leaf-left"><path d="M240 344C124 346 63 280 76 177c112-3 180 63 164 167Z" fill="var(--accent)" /><path d="M240 344 107 208M150 249l-3-43M185 284l-47-2" stroke="var(--accent-ink)" stroke-width="2" /></g>
          <g class="growth-leaf growth-leaf-right"><path d="M240 287c-13-101 54-168 164-167 14 105-51 171-164 167Z" fill="var(--ink)" /><path d="m240 287 133-137m-91 92 49 1m-16-35 1-42" stroke="var(--surface)" stroke-width="2" /></g>
          <g class="growth-leaf growth-leaf-top"><path d="M240 204c-72-41-83-105-31-164 73 41 87 105 31 164Z" fill="var(--accent)" /><path d="m240 204-26-128" stroke="var(--accent-ink)" stroke-width="2" /></g>
          <path d="M176 419h128" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <circle cx="394" cy="365" r="12" stroke="currentColor" stroke-opacity=".55" />
          <path d="M87 104h16m-8-8v16" stroke="currentColor" stroke-opacity=".55" />
        </svg>
        <figcaption><span>持续生长，不必完美。</span><span class="growth-status"><i aria-hidden="true"></i>写作中</span></figcaption>
      </figure>
    </section>

    <div class="folio-colophon">
      <dl>{lede.map((item) => <div><dd>{formatNumber(item.value)}</dd><dt>{item.label}</dt></div>)}</dl>
      {profile.announcement && <p><span>近况</span>{profile.announcement}</p>}
    </div>

    <section class="notes-section" id="latest" aria-labelledby="notes-title">
      <div class="notes-index">
        <p class="notes-intro">最近，正在记录</p>
        <h2 id="notes-title">新的<br /><em>枝叶。</em></h2>
        <p class="notes-description">技术里的细节，生活里的片刻。<br />慢慢积累，偶尔回看。</p>
        <a href="/archive" class="folio-about">按时间翻阅 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="notes-feed">
        {latest.items.length === 0 ? <div class="empty-state"><h3>第一篇，还在酝酿中。</h3><a href="/guestbook" class="text-link">去留言</a></div> : latest.items.map((post, index) => <ArticleCard post={post} featured={index === 0} motion />)}
        <a href="/post" class="notes-all" data-magnetic><span>翻阅全部文章</span><span class="font-mono">{formatNumber(summary.postCount)} <span aria-hidden="true">↗</span></span></a>
      </div>
    </section>

    <section class="garden-paths" aria-labelledby="paths-title">
      <div class="paths-heading"><h2 id="paths-title">随处逛逛。</h2><p>不只有文章，还有一些顺手留下的小东西。</p></div>
      <div class="paths-grid">
        <a class="path-card" href="/tags"><span class="path-icon" aria-hidden="true">#</span><h3>循着兴趣</h3><p>从一个关键词出发。</p><div class="path-tags">{tags.slice(0, 4).map(tag => <span>{tag.name}</span>)}</div><span class="path-go" aria-hidden="true">↗</span></a>
        <a class="path-card" href="/toolbox"><span class="path-icon" aria-hidden="true">⌘</span><h3>顺手工具</h3><p>让重复的事情，变得简单一点。</p><span class="path-detail">打开工具箱</span><span class="path-go" aria-hidden="true">↗</span></a>
        <a class="path-card" href="/categories"><span class="path-icon" aria-hidden="true">∗</span><h3>分门别类</h3><p>给散落的笔记，找一个位置。</p><span class="path-detail">浏览文章分类</span><span class="path-go" aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="garden-invitation" aria-labelledby="invitation-title">
      <p>花园不是独白。</p>
      <h2 id="invitation-title" data-word-reveal>{Array.from(motto).map(char => <span>{char}</span>)}</h2>
      <div class="invitation-action"><span>如果你也有想法，欢迎留下一句。</span><a href="/guestbook" class="invitation-link" data-magnetic>聊两句 <span aria-hidden="true">↗</span></a></div>
    </section>
    <GardenMotion client:only="react" />
  </div>
</BaseLayout>
