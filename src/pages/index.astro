---
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);

import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { listPosts, listTags } from '@/server/db/content';
import { getSiteProfile } from '@/server/db/settings';
import GardenMotion from '@/components/GardenMotion.tsx';
import BotanicalStudy from '@/components/BotanicalStudy.astro';

const db = env.DB;
const [profile, latest, tags] = await Promise.all([
  getSiteProfile(db),
  listPosts(db, { page: 1, pageSize: 6 }),
  listTags(db)
]);
---

<BaseLayout title={profile.name} description={profile.bio} active="home">
  <div class="living-garden" data-garden>
    <section class="folio-hero" aria-labelledby="garden-title">
      <div class="folio-copy" data-motion>
        <div class="folio-identity">
          {profile.avatar && <img src={profile.avatar} alt={t("Kale 的头像")} width={44} height={44} />}
          <div><p>{profile.name}</p><span lang={locale}>{t("Software, systems & independent work.")}</span></div>
        </div>
        <h1 id="garden-title" lang={locale}>{t("Engineering.")}<br />{t("In practice.")}</h1>
        <p class="folio-bio" lang={locale}>{t("Notes on building software, understanding systems, and learning through practice.")}</p>
        <div class="folio-actions">
          <a href="#latest" class="btn btn-primary" data-magnetic><span>{t("阅读文章")}</span><svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></a>
          <a href="/about" class="folio-about">{t("关于我")}<span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <BotanicalStudy latest={latest.items[0]} />
    </section>

    {profile.announcement && <div class="folio-colophon">
      <p><span>{t("近况")}</span>{profile.announcement}</p>
    </div>}

    <section class="notes-section" id="latest" aria-labelledby="notes-title">
      <div class="notes-index">
        <p class="notes-intro">{t("文章与手记")}</p>
        <h2 id="notes-title" lang={locale}>{t("Latest writing")}</h2>
        <p class="notes-description" lang={locale}>{t("Technical notes, considered opinions,")}<br />{t("and lessons from real projects.")}</p>
        <a href="/archive" class="folio-about">{t("查看归档")}<span aria-hidden="true">↗</span></a>
      </div>
      <div class="notes-feed">
        {latest.items.length === 0 ? <div class="empty-state"><h3>{t("暂无文章。")}</h3><a href="/guestbook" class="text-link">{t("去留言")}</a></div> : latest.items.map((post, index) => <ArticleCard post={post} featured={index === 0} motion />)}
        <a href="/post" class="notes-all" data-magnetic><span>{t("查看全部文章")}</span><span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="garden-paths" aria-labelledby="paths-title">
      <div class="paths-heading"><h2 id="paths-title" lang={locale}>{t("Beyond the articles")}</h2><p>{t("Topics, utilities, and a structured archive.")}</p></div>
      <div class="paths-grid">
        <a class="path-card" href="/tags"><svg class="path-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="m12 5-3 22M23 5l-3 22M5 12h23M4 21h23" stroke="currentColor" stroke-width="1.3"/></svg><h3 lang={locale}>{t("Topics")}</h3><p lang={locale}>{t("Explore the ideas behind the work.")}</p><div class="path-tags">{tags.slice(0, 4).map(tag => <span>{tag.name}</span>)}</div><span class="path-go" aria-hidden="true">↗</span></a>
        <a class="path-card" href="/toolbox"><svg class="path-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="m11 9-7 7 7 7m10-14 7 7-7 7M18 5l-4 22" stroke="currentColor" stroke-width="1.3"/></svg><h3 lang={locale}>{t("Utilities")}</h3><p lang={locale}>{t("Small tools. Less friction.")}</p><span class="path-detail">{t("打开工具箱")}</span><span class="path-go" aria-hidden="true">↗</span></a>
        <a class="path-card" href="/categories"><svg class="path-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M5 9h9l3 4h10v14H5V9Zm0 0V5h11l3 4h8v4" stroke="currentColor" stroke-width="1.3"/></svg><h3 lang={locale}>{t("Collections")}</h3><p lang={locale}>{t("A clear index of everything here.")}</p><span class="path-detail">{t("浏览文章分类")}</span><span class="path-go" aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="garden-invitation" aria-labelledby="invitation-title">
      <p lang={locale}>{t("Open for conversation")}</p>
      <h2 id="invitation-title" lang={locale}>{t("Good work starts with")}<br />{t("a conversation.")}</h2>
      <div class="invitation-action"><span>{t("Questions, feedback, or a different perspective — all welcome.")}</span><a href="/guestbook" class="invitation-link" data-magnetic>{t("留言")}<span aria-hidden="true">↗</span></a></div>
    </section>
    <GardenMotion locale={locale} client:only="react" />
  </div>
</BaseLayout>

<!-- avoid-ai-design-ignore-file: K7 — 全站键盘焦点使用 globals.css 的 :focus-visible。 -->
