---
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeading from '@/components/PageHeading.astro';
import GuestbookSection from '@/components/GuestbookSection.tsx';
import { listGuestbook } from '@/server/db/interactions';
import type { GuestbookItem } from '@/types/domain';

const db = env.DB;
const items = await listGuestbook(db);
const total = items.reduce(function count(acc: number, item: GuestbookItem): number {
  return acc + 1 + (item.replies ?? []).reduce(count, 0);
}, 0);
---

<BaseLayout title={t("留言板")} description={t("留言与交流")} active="guestbook">
  <PageHeading title={t("园中留言")} description={t("路过也好，常来也好，留下一点你的声音。")} />
  <p class="mt-4 text-xs text-muted">{t("留言经园主审核后展示，支持回复。")}</p>
  <div class="mt-8">
    <GuestbookSection locale={locale} client:visible initialItems={items} initialTotal={total} />
  </div>
</BaseLayout>
