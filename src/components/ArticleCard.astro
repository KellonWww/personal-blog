---
import type { PostSummary } from '@/types/domain';
import { formatDate, readingTime } from '@/lib/format';
import PostCover from '@/components/PostCover.astro';

interface Props {
  post: PostSummary;
  order?: number;
  featured?: boolean;
  motion?: boolean;
}

const { post, order, featured = false, motion = false } = Astro.props;
const date = formatDate(post.publishedAt ?? post.createdAt);
const index = typeof order === 'number' ? String(order).padStart(2, '0') : null;
const href = `/post/${post.slug}`;
---

<article data-motion={motion || undefined} class:list={["article-row group", { "article-featured": featured }]}>
  <div class="index-rail">
    {index && <span class="article-number">{index}</span>}
    {featured && <span class="article-fresh">最近更新</span>}
    <time datetime={post.publishedAt ?? post.createdAt} class="tabular-nums">{date}</time>
    <p class="text-muted">{readingTime(post.wordCount)}</p>
  </div>

  <div class="flex items-start gap-4 sm:gap-5">
    <div class="min-w-0 flex-1">
      <h2 class="article-title">
        <a href={href} class="transition-colors">{post.title}</a>
      </h2>
      {post.summary && <p class="article-summary line-clamp-2">{post.summary}</p>}
      <div class="mt-2.5 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-muted">
        {post.categories.map((category) => (
          <a href={`/post?category=${category.slug}`} class="transition-colors hover:text-accent">{category.name}</a>
        ))}
        {post.tags.slice(0, 3).map((tag) => (
          <a href={`/post?tag=${tag.slug}`} class="transition-colors hover:text-accent">#{tag.name}</a>
        ))}
        <span class="ml-auto font-mono text-[0.7rem] tabular-nums">{post.viewCount} 阅读 · {post.commentCount} 评论</span>
      </div>
    </div>

    {post.coverImage && <a
      href={href}
      tabindex="-1"
      aria-hidden="true"
      class="article-cover"
    >
      <PostCover src={post.coverImage} title={post.title} class="h-full w-full object-cover" />
    </a>}
  </div>
</article>

