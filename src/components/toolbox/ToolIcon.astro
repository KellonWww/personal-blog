---
import type { ToolIconName } from '@/lib/tool-definitions';

interface Props {
  name: ToolIconName;
  size?: string;
}

const { name, size = '1.5rem' } = Astro.props;
const paths: Record<ToolIconName, string> = {
  format: 'M8 3H6a2 2 0 0 0-2 2v4l-2 3 2 3v4a2 2 0 0 0 2 2h2M16 3h2a2 2 0 0 1 2 2v4l2 3-2 3v4a2 2 0 0 1-2 2h-2M10 8h4M10 12h4M10 16h4',
  time: 'M21 12a9 9 0 1 1-3-6.7M21 3v5h-5M12 7v5l3 2',
  diff: 'M9 3H4a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h5M15 3h5a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1h-5M12 3v18M5 12h4M15 12h4M17 10v4',
  codec: 'm7 7-5 5 5 5M17 7l5 5-5 5M14 4l-4 16',
  text: 'M3 15 7 5l4 10M4.5 12h5M14 6h7M14 10h5M14 14h7M3 20h18',
  regex: 'M10 4v10M5.7 6.5l8.6 5M5.7 11.5l8.6-5M18 17h.01M6 20h12'
};
---

<svg class="tool-icon" data-tool-icon={name} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={paths[name]} />
</svg>

<style>
  .tool-icon { display: inline-block; flex-shrink: 0; color: var(--accent); vertical-align: middle; }
</style>
