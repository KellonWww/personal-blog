---
import { getLocale, LOCALE_COOKIE } from '@/lib/i18n';
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const next = locale === 'en' ? 'zh-CN' : 'en';
const label = locale === 'en' ? '切换到中文' : 'Switch to English';
---
<form action="/language" method="post" class="language-switcher" data-language-switch>
  <input type="hidden" name="locale" value={next} />
  <input type="hidden" name="returnTo" value={Astro.url.pathname + Astro.url.search} />
  <button type="submit" class="language-toggle" aria-label={label} title={label}>
    <span lang="zh-CN" class:list={{ 'is-current': locale === 'zh-CN' }}>中</span>
    <span aria-hidden="true" class="language-divider">/</span>
    <span lang="en" class:list={{ 'is-current': locale === 'en' }}>EN</span>
  </button>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-language-switch]').forEach(form => {
    form.addEventListener('submit', () => {
      const returnTo = form.elements.namedItem('returnTo');
      if (returnTo instanceof HTMLInputElement) returnTo.value = location.pathname + location.search + location.hash;
    });
  });
</script>
<style is:global>
  .language-switcher { display: inline-flex; flex-shrink: 0; margin: 0; }
  .language-toggle { display: inline-flex; align-items: center; justify-content: center; gap: .32rem; min-height: 40px; min-width: 60px; padding: .4rem .55rem; border: 1px solid var(--line); border-radius: 9px; background: color-mix(in srgb, var(--paper) 45%, transparent); color: var(--muted); font: 500 .7rem/1 var(--font-sans); cursor: pointer; transition: background 180ms, border-color 180ms; }
  .language-toggle .is-current { color: var(--ink); font-weight: 700; }
  .language-divider { opacity: .4; }
  .language-toggle:hover { background: var(--accent-soft); border-color: var(--accent-line); }
  .admin-language { position: fixed; top: 1rem; right: 1rem; z-index: 60; }
  html[lang="en"] .header-nav { gap: .12rem; }
  html[lang="en"] .header-nav .nav-item { padding-inline: .55rem; }
  @media (max-width: 400px) { .language-toggle { gap: .2rem; min-width: 49px; padding-inline: .35rem; } .header-inner { gap: .5rem; } }
  @media (prefers-reduced-motion: reduce) { .language-toggle { transition: none; } }
</style>
