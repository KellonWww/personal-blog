---
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);

interface Props {
  latest?: { title: string; slug: string; summary: string };
}
const { latest } = Astro.props;
const leaves = [
  { x: 232, y: 360, angle: -69, scale: 1.08 },
  { x: 238, y: 313, angle: 58, scale: 1.12 },
  { x: 241, y: 270, angle: -64, scale: .96 },
  { x: 247, y: 226, angle: 51, scale: .91 },
  { x: 248, y: 185, angle: -51, scale: .79 },
  { x: 252, y: 147, angle: 44, scale: .67 },
  { x: 253, y: 113, angle: -35, scale: .52 },
  { x: 255, y: 85, angle: 14, scale: .46 }
];
---
<figure class="growth-art botanical-study" aria-label={t("撞色枝叶与蓝色底板的植物标本，与最新一篇真实手记")}>
  <div class="specimen-shadow" aria-hidden="true"></div>
  <div class="specimen-plate">
    <div class="specimen-caption"><span lang={locale}>{t("Notes from the field.")}</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v18M3 12h18" stroke="currentColor" stroke-width="1"/></svg></div>
    <svg class="botanical-svg" viewBox="0 0 480 480" fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="leaf-front" x1="0" y1="0" x2="100" y2="-140" gradientUnits="userSpaceOnUse"><stop stop-color="var(--botanical-deep)"/><stop offset=".5" stop-color="var(--botanical-mid)"/><stop offset="1" stop-color="var(--botanical-light)"/></linearGradient>
        <linearGradient id="leaf-back" x1="0" y1="0" x2="-100" y2="-120" gradientUnits="userSpaceOnUse"><stop stop-color="var(--botanical-deep)"/><stop offset="1" stop-color="var(--botanical-mid)"/></linearGradient>
      </defs>
      <path d="M207 458c17-43 26-95 32-154 8-77 7-161 18-239" stroke="var(--botanical-deep)" stroke-width="2.2" stroke-linecap="round"/>
      {leaves.map((leaf, index) => <g transform={`translate(${leaf.x} ${leaf.y}) rotate(${leaf.angle}) scale(${leaf.scale})`}>
        <path d="M0 0C-37-18-63-72-20-139 20-119 49-52 0 0Z" fill={index % 2 ? 'url(#leaf-back)' : 'url(#leaf-front)'} />
        <path d="M0 0C-3-42-11-86-20-139" stroke="var(--botanical-vein)" stroke-width="1" stroke-opacity=".75"/>
        <path d="m-3-30-20-26m18 6 21-22m-25-2-19-22m16 0 15-19" stroke="var(--botanical-vein)" stroke-width=".65" stroke-opacity=".45"/>
      </g>)}
      <path d="M335 360h54m-27-27v54" stroke="var(--botanical-deep)" stroke-width=".8" opacity=".4"/>
    </svg>
    <div class="specimen-footnote"><span lang={locale}>{t("Always in progress.")}</span><span>{t("Kale 的数字花园")}</span></div>
  </div>
  {latest && <figcaption class="specimen-note">
    <div class="specimen-note-label"><span class="specimen-note-dot" aria-hidden="true"></span>{t("最新文章")}</div>
    <a href={`/post/${latest.slug}`} class="specimen-note-title">{latest.title}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5"/></svg></a>
    {latest.summary && <p>{latest.summary}</p>}
  </figcaption>}
</figure>
