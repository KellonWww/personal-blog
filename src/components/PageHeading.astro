---
import { getLocale, LOCALE_COOKIE, translator } from '@/lib/i18n';
const locale = getLocale(Astro.cookies.get(LOCALE_COOKIE)?.value);
const t = translator(locale);

interface Props {
  title: string;
  description?: string;
  meta?: string;
}
const { title, description, meta } = Astro.props;
---
<header class="page-heading" data-motion>
  <div class="page-heading-copy">
    <div class="page-heading-line"><h1>{title}</h1>{meta && <span>{t(meta)}</span>}</div>
    {description && <p>{t(description)}</p>}
  </div>
  <span class="page-heading-mark" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none"><path d="M17 49C19 30 33 12 51 11c1 20-10 35-29 34M17 49 44 20" stroke="currentColor" stroke-width="1.3"/><path d="m27 37-1-12m10 3 11 1" stroke="currentColor" stroke-width="1.3"/></svg></span>
</header>
