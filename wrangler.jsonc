{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-blog",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-blog-db",
      "database_id": "f5fcdd13-3fad-481a-9b43-6715d8f131cd",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "2ec9cc97e9604113aba70d0b34706690"
    }
  ],
  "vars": {
    "SITE_URL": "https://personal-blog.stock-backend-wkl.workers.dev",
    "ENVIRONMENT": "production",
    "AUTH_DEV_MODE": "false",
    "ARCHIVES_ENABLED": "false",
    "ARCHIVE_PUBLICATION_ENABLED": "false"
  },
  "observability": {
    "enabled": true
  }
}